// Logical model from SRS section 7, made concrete.
// Money uses Decimal(12,2). Snapshots on Order/OrderItem keep historic receipts intact.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ---------- Enums ----------

enum Role {
  CUSTOMER
  FULFILMENT
  MARKETING
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum InventoryReason {
  RESTOCK
  ADJUSTMENT
  RESERVATION
  RESERVATION_RELEASE
  SALE
  RETURN
}

enum ReservationStatus {
  ACTIVE
  CONSUMED
  RELEASED
}

enum FulfilmentType {
  PICKUP
  DELIVERY
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  PAYMENT_FAILED
  PROCESSING
  READY_FOR_PICKUP
  OUT_FOR_DELIVERY
  DELIVERY_EXCEPTION
  COMPLETED
  CANCELLED
  EXPIRED
  REFUND_PENDING
}

enum PaymentStatus {
  CREATED
  PENDING
  SUCCEEDED
  FAILED
  EXPIRED
  REFUND_PENDING
  REFUNDED
  PARTIALLY_REFUNDED
}

enum DiscountType {
  PERCENT
  FIXED
}

enum OutboxChannel {
  EMAIL
  WHATSAPP
}

enum OutboxStatus {
  PENDING
  PROCESSING
  SENT
  DEAD
}

enum ModerationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PublishStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

enum RefundStatus {
  PENDING // sent to the provider, not yet confirmed
  SUCCEEDED
  FAILED
}

enum RefundMethod {
  PROVIDER // refunded through the payment provider's API
  MANUAL // refunded outside the system (cash, MoMo transfer); recorded for the books
}

enum ServiceRequestStatus {
  SUBMITTED // waiting for a quote
  QUOTED // quote sent, waiting for the customer
  ACCEPTED // customer accepted, deposit not yet paid
  CONFIRMED // deposit paid (or no deposit needed): booked
  DECLINED // customer declined the quote (staff may re-quote)
  REJECTED // shop can't take it on
  COMPLETED
  CANCELLED
}

// ---------- Identity ----------

model User {
  id              String     @id @default(cuid())
  email           String     @unique
  phone           String?
  name            String
  passwordHash    String
  role            Role       @default(CUSTOMER)
  status          UserStatus @default(ACTIVE)
  emailVerifiedAt DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  sessions          Session[]
  passwordResets    PasswordResetToken[]
  addresses         Address[]
  orders            Order[]
  wishlist          WishlistItem[]
  couponRedemptions CouponRedemption[]
  reviews           Review[]
  serviceRequests   ServiceRequest[]
  giveawayEntries   GiveawayEntry[]
}

model Session {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  ip        String?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Address {
  id                   String   @id @default(cuid())
  userId               String
  recipientName        String
  phone                String
  addressLine          String
  region               String // one of Ghana's 16 regions
  area                 String // town / neighbourhood
  city                 String
  deliveryInstructions String?
  isDefault            Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ---------- Catalogue ----------

model Category {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  description String?
  imageUrl    String?
  parentId    String?
  sortOrder   Int        @default(0)
  isActive    Boolean    @default(true)
  returnWindowDays Int?  // working days; null = inherit from parent, then store default; 0 = not returnable
  parent      Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children    Category[] @relation("CategoryTree")
  products    Product[]

  @@index([parentId, sortOrder])
}

model Product {
  id             String        @id @default(cuid())
  name           String
  slug           String        @unique
  description    String
  categoryId     String
  status         ProductStatus @default(DRAFT)
  basePrice      Decimal       @db.Decimal(12, 2)
  compareAtPrice Decimal?      @db.Decimal(12, 2)
  images         String[]
  attributes     Json?
  brand          String? // maker, mainly for kitchenware and decoration (cakes are your own)
  isFeatured     Boolean       @default(false)
  pickupOnly     Boolean       @default(false) // e.g. fragile cakes
  returnWindowDays Int?        // working days; null = use category, 0 = not returnable
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  category  Category         @relation(fields: [categoryId], references: [id])
  variants  ProductVariant[]
  wishlist  WishlistItem[]
  reviews   Review[]
  orderItems OrderItem[]

  @@index([status, categoryId])
  @@index([status, createdAt])
  @@index([status, brand])
}

model ProductVariant {
  id            String   @id @default(cuid())
  productId     String
  name          String   @default("Standard")
  sku           String   @unique
  options       Json?
  price         Decimal? @db.Decimal(12, 2) // null = product.basePrice
  trackStock    Boolean  @default(true)
  stockOnHand   Int      @default(0)
  stockReserved Int      @default(0)
  isActive      Boolean  @default(true)
  sortOrder     Int      @default(0)

  product      Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  movements    InventoryMovement[]
  reservations StockReservation[]
  orderItems   OrderItem[]

  @@index([productId])
}

model InventoryMovement {
  id        String          @id @default(cuid())
  variantId String
  delta     Int
  reason    InventoryReason
  actorId   String?
  orderId   String?
  note      String?
  createdAt DateTime        @default(now())
  variant   ProductVariant  @relation(fields: [variantId], references: [id])

  @@index([variantId, createdAt])
}

model StockReservation {
  id        String            @id @default(cuid())
  orderId   String
  variantId String
  quantity  Int
  status    ReservationStatus @default(ACTIVE)
  expiresAt DateTime
  createdAt DateTime          @default(now())
  order     Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant   ProductVariant    @relation(fields: [variantId], references: [id])

  @@index([orderId, status])
}

model WishlistItem {
  userId    String
  productId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([userId, productId])
}

// ---------- Delivery & promotions ----------

/// Nationwide delivery: one default zone per region (areas = []) plus optional
/// area-specific zones inside a region (e.g. cheaper central Accra). Most specific match wins.
model DeliveryZone {
  id                    String   @id @default(cuid())
  name                  String
  region                String
  areas                 String[] // empty = whole region; else matched case-insensitively against Address.area
  leadTime              String?  // shown to customers, e.g. "2–3 working days"
  fee                   Decimal  @db.Decimal(12, 2)
  minimumOrder          Decimal? @db.Decimal(12, 2)
  freeDeliveryThreshold Decimal? @db.Decimal(12, 2)
  serviceHours          String?
  isActive              Boolean  @default(true)
  sortOrder             Int      @default(0)

  @@index([region, isActive])
}

/// Owner-editable store settings (single row, id = "default").
model StoreSettings {
  id                      String   @id @default("default")
  paymentWindowMinutes    Int      @default(10)
  returnWindowWorkingDays Int      @default(3)
  pricesIncludeTax        Boolean  @default(false)
  serviceLeadDays         Int      @default(3) // minimum days' notice for custom cake / event requests
  reviewsRequirePurchase  Boolean  @default(true) // only customers who bought the product can review it
  publicHolidays          String[] // YYYY-MM-DD, skipped when counting working days
  updatedBy               String?
  updatedAt               DateTime @updatedAt
}

/// Tax lines applied at checkout, in sortOrder. Confirm names and rates with your accountant.
model TaxRate {
  id                String   @id @default(cuid())
  name              String
  rate              Decimal  @db.Decimal(6, 4) // 0.1500 = 15%
  appliesToDelivery Boolean  @default(false)
  isActive          Boolean  @default(false)
  sortOrder         Int      @default(0)
  updatedAt         DateTime @updatedAt
}

model Coupon {
  id             String       @id @default(cuid())
  code           String       @unique // stored upper-case
  description    String?
  discountType   DiscountType
  value          Decimal      @db.Decimal(12, 2)
  maxDiscount    Decimal?     @db.Decimal(12, 2)
  minimumSpend   Decimal?     @db.Decimal(12, 2)
  startsAt       DateTime?
  endsAt         DateTime?
  maxUses        Int?
  usedCount      Int          @default(0)
  perUserLimit   Int?
  firstOrderOnly Boolean      @default(false)
  productIds     String[]
  categoryIds    String[]
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  redemptions    CouponRedemption[]
}

model CouponRedemption {
  id             String   @id @default(cuid())
  couponId       String
  userId         String
  orderId        String   @unique
  discountAmount Decimal  @db.Decimal(12, 2)
  createdAt      DateTime @default(now())
  coupon         Coupon   @relation(fields: [couponId], references: [id])
  user           User     @relation(fields: [userId], references: [id])
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([couponId, userId])
}

// ---------- Orders & payments ----------

model Order {
  id                   String         @id @default(cuid())
  orderNumber          String         @unique
  userId               String
  checkoutKey          String // client idempotency key
  status               OrderStatus    @default(PENDING_PAYMENT)
  paymentStatus        PaymentStatus  @default(CREATED)
  fulfilmentType       FulfilmentType
  currency             String         @db.Char(3)
  subtotal             Decimal        @db.Decimal(12, 2)
  discountTotal        Decimal        @db.Decimal(12, 2)
  taxTotal             Decimal        @db.Decimal(12, 2)
  taxLines             Json? // [{ name, rate, amount }] snapshot
  pricesIncludeTax     Boolean        @default(false)
  deliveryFee          Decimal        @db.Decimal(12, 2)
  total                Decimal        @db.Decimal(12, 2)
  couponCode           String?
  deliveryZoneName     String?
  contactName          String
  contactEmail         String
  contactPhone         String
  shippingAddress      Json?
  notes                String?
  reservationExpiresAt DateTime?
  needsReconciliation  Boolean        @default(false)
  serviceRequestId     String? // set on deposit orders for custom-cake/event requests
  placedAt             DateTime       @default(now())
  paidAt               DateTime?
  completedAt          DateTime? // starts the returns clock
  updatedAt            DateTime       @updatedAt

  user          User                 @relation(fields: [userId], references: [id])
  items         OrderItem[]
  payments      Payment[]
  reservations  StockReservation[]
  history       OrderStatusHistory[]
  redemption    CouponRedemption?
  serviceRequest ServiceRequest?    @relation(fields: [serviceRequestId], references: [id])
  refunds        Refund[]

  @@unique([userId, checkoutKey])
  @@index([serviceRequestId])
  @@index([userId, placedAt])
  @@index([status, placedAt])
  @@index([status, reservationExpiresAt])
}

model OrderItem {
  id          String          @id @default(cuid())
  orderId     String
  productId   String?
  variantId   String?
  productName String
  variantName String
  sku         String
  imageUrl    String?
  unitPrice   Decimal         @db.Decimal(12, 2)
  quantity    Int
  lineTotal   Decimal         @db.Decimal(12, 2)
  returnWindowDays Int        @default(0) // snapshot at purchase; later policy changes don't apply retroactively
  order       Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant     ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([orderId])
}

model OrderStatusHistory {
  id        String       @id @default(cuid())
  orderId   String
  from      OrderStatus?
  to        OrderStatus
  actorId   String?
  note      String?
  createdAt DateTime     @default(now())
  order     Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
}

model Payment {
  id                    String        @id @default(cuid())
  orderId               String
  provider              String
  reference             String        @unique // our reference, sent to the provider
  providerTransactionId String?
  amount                Decimal       @db.Decimal(12, 2)
  currency              String        @db.Char(3)
  status                PaymentStatus @default(CREATED)
  checkoutUrl           String?
  failureReason         String?
  verifiedAt            DateTime?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  order                 Order         @relation(fields: [orderId], references: [id])
  refunds               Refund[]

  @@index([orderId])
  @@index([status, createdAt])
}

model Refund {
  id               String       @id @default(cuid())
  orderId          String
  paymentId        String
  amount           Decimal      @db.Decimal(12, 2)
  reason           String
  method           RefundMethod
  status           RefundStatus @default(PENDING)
  restock          Json? // [{ variantId, quantity }] returned to stock
  idempotencyKey   String       @unique
  providerRefundId String?
  failureReason    String?
  createdBy        String
  createdAt        DateTime     @default(now())
  completedAt      DateTime?
  order            Order        @relation(fields: [orderId], references: [id])
  payment          Payment      @relation(fields: [paymentId], references: [id])

  @@index([orderId])
  @@index([status, completedAt])
}

model PaymentEvent {
  id               String   @id @default(cuid())
  provider         String
  eventId          String
  paymentReference String
  payload          Json // redacted before storage
  receivedAt       DateTime @default(now())
  processedAt      DateTime?

  @@unique([provider, eventId])
  @@index([paymentReference])
}

// ---------- Notifications & audit ----------

model OutboxEvent {
  id             String        @id @default(cuid())
  channel        OutboxChannel
  type           String
  recipient      String
  payload        Json
  idempotencyKey String        @unique
  orderId        String?
  status         OutboxStatus  @default(PENDING)
  attempts       Int           @default(0)
  nextAttemptAt  DateTime      @default(now())
  lockedAt       DateTime?
  lastError      String?
  sentAt         DateTime?
  createdAt      DateTime      @default(now())

  @@index([status, nextAttemptAt])
}

/// Marketing email list. Kept separate from accounts: anyone can subscribe, consent is recorded,
/// and every email carries a one-click unsubscribe link (SRS 10.3).
model NewsletterSubscriber {
  id               String    @id @default(cuid())
  email            String    @unique
  source           String // e.g. home.sidebar, footer
  consentAt        DateTime
  unsubscribeToken String    @unique
  unsubscribedAt   DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([unsubscribedAt])
}

enum ContactStatus {
  NEW
  HANDLED
}

/// Messages sent from the Contact page. The owner is emailed; staff mark them handled in the admin.
model ContactMessage {
  id          String        @id @default(cuid())
  name        String
  email       String
  phone       String?
  topic       String // ORDER | CUSTOM_CAKE | DELIVERY | PRODUCT | OTHER
  orderNumber String?
  message     String
  status      ContactStatus @default(NEW)
  handledBy   String?
  handledAt   DateTime?
  createdAt   DateTime      @default(now())

  @@index([status, createdAt])
}

model AuditLog {
  id           String   @id @default(cuid())
  actorId      String?
  action       String
  resourceType String
  resourceId   String
  requestId    String?
  before       Json?
  after        Json?
  createdAt    DateTime @default(now())

  @@index([resourceType, resourceId])
  @@index([createdAt])
}

// ---------- Phase 5 (modelled, modules not yet built) ----------

model Review {
  id               String           @id @default(cuid())
  userId           String
  productId        String
  rating           Int // 1–5
  title            String?
  body             String
  status           ModerationStatus @default(PENDING)
  verifiedPurchase Boolean          @default(false)
  moderatedBy      String?
  moderatedAt      DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  user             User             @relation(fields: [userId], references: [id])
  product          Product          @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([productId, status])
  @@index([status, createdAt])
}

model Campaign {
  id        String        @id @default(cuid())
  name      String
  slug      String        @unique
  status    PublishStatus @default(DRAFT)
  startsAt  DateTime?
  endsAt    DateTime?
  content   Json? // { headline, body, heroImage, productIds[], couponCode }
  banners   Banner[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

model Banner {
  id             String        @id @default(cuid())
  campaignId     String?
  title          String
  desktopImage   String
  mobileImage    String?
  altText        String
  placement      String // e.g. home.hero, category.top, product.sidebar
  destinationUrl String
  isSponsored    Boolean       @default(false)
  priority       Int           @default(0)
  status         PublishStatus @default(DRAFT)
  startsAt       DateTime?
  endsAt         DateTime?
  clicks         Int           @default(0) // lifetime clicks
  createdAt      DateTime      @default(now())
  campaign       Campaign?     @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  @@index([placement, status])
}

model Giveaway {
  id                String          @id @default(cuid())
  slug              String          @unique
  title             String
  prize             String
  description       String
  imageUrl          String?
  rules             String // full terms incl. eligibility and the privacy statement
  status            PublishStatus   @default(DRAFT)
  opensAt           DateTime
  closesAt          DateTime
  entryLimit        Int             @default(1) // entries per customer
  winnerUserId      String?
  winnerDisplayName String? // e.g. "Ama K." (published)
  winnerDrawnAt     DateTime?
  excludedUserIds   String[] // previous winners skipped on a redraw
  createdAt         DateTime        @default(now())
  entries           GiveawayEntry[]
}

model GiveawayEntry {
  id         String   @id @default(cuid())
  giveawayId String
  userId     String
  data       Json?
  ipHash     String?
  createdAt  DateTime @default(now())
  giveaway   Giveaway @relation(fields: [giveawayId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id])

  @@index([giveawayId, userId])
}

model Service {
  id          String           @id @default(cuid())
  name        String
  slug        String           @unique
  description String
  imageUrl    String?
  isActive    Boolean          @default(true)
  sortOrder   Int              @default(0)
  requests    ServiceRequest[]
}

model ServiceRequest {
  id                   String               @id @default(cuid())
  reference            String               @unique // SR-YYMMDD-XXXX, shown to customers
  serviceId            String
  userId               String
  status               ServiceRequestStatus @default(SUBMITTED)
  eventDate            DateTime             @db.Date
  guestCount           Int?
  budget               Decimal?             @db.Decimal(12, 2)
  fulfilmentPreference String // PICKUP | DELIVERY | ON_SITE
  location             String?
  notes                String
  referenceImages      String[] // PRIVATE storage paths; served via short-lived signed URLs
  contactPhone         String
  quoteAmount          Decimal?             @db.Decimal(12, 2) // full price the customer pays
  depositAmount        Decimal?             @db.Decimal(12, 2) // 0 = no deposit needed
  quoteNote            String? // what's included, delivery/setup, balance terms
  quoteValidUntil      DateTime?            @db.Date
  quotedAt             DateTime?
  acceptedAt           DateTime?
  depositPaidAt        DateTime?
  closedReason         String?
  staffNotes           String?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  service              Service              @relation(fields: [serviceId], references: [id])
  user                 User                 @relation(fields: [userId], references: [id])
  orders               Order[] // deposit orders (paid through the normal payment flow)

  @@index([status, createdAt])
  @@index([userId, createdAt])
}
